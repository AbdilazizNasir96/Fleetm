# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.wutbbjwerdsvzlutxshn:abdi0377AAA@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
SESSION_SECRET=local-dev-secret-change-me-min-32-chars-for-jwt-signing
PORT=8080
NODE_ENV=development

# ── Optional: Email (SendGrid) ─────────────────────────────────────────────────
# Leave unset in development — emails are logged to the console instead
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@digivant.com

# ── Optional: File uploads (Azure Blob Storage) ────────────────────────────────
# Leave unset to fall back to local disk storage under ./uploads
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER_NAME=digivant-uploads

# ── Optional: Real-time (Redis / Socket.IO) ────────────────────────────────────
# Leave unset to use the in-memory adapter (single-instance only)
# REDIS_URL=

# ── Optional: Links in emails ─────────────────────────────────────────────────
# Defaults to https://$REPLIT_DOMAINS or http://localhost:80
APP_URL=http://localhost:8080

# ── Optional: Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info
